#!/usr/bin/env bash
# rig-update: update this rig container's toolchain and AI agents in place,
# without rebuilding the image. Generated by rig from .rig.yml.
#
# Updates live in this container only: they are lost when rig recreates it
# (after a .rig.yml change or `rig rebuild`), which starts again from the image.
set -o pipefail

usage() {
  cat <<'USAGE'
Usage: rig-update [--list] [STEP...]

Update this container's toolchain and AI agents without rebuilding the image.
With no STEP, every step runs. Steps always run in the order --list shows,
because runtimes must be upgraded before the packages installed into them.

Versions pinned in .rig.yml are respected: a runtime pinned to 1.22 moves only
within 1.22.x, and a build system pinned to an exact version is not upgraded.

Options:
  -l, --list   list the steps and exit
  -h, --help   show this help and exit
USAGE
}

export PATH="$HOME/.local/bin:$PATH"
export MISE_YES=1
MISE="$HOME/.local/bin/mise"

# mx runs a command against the runtime versions mise currently selects, so it
# sees runtimes upgraded earlier in the same run.
mx() { "$MISE" exec -- "$@"; }
{{ range .Steps }}
{{ .FuncName }}() {
  {{ .Body }}
}
{{ end }}
STEPS=({{ range $i, $s := .Steps }}{{ if $i }} {{ end }}{{ $s.Name }}{{ end }})
declare -A DESCRIPTIONS=(
{{- range .Steps }}
  [{{ .Name }}]={{ shellQuote .Description }}
{{- end }}
)
declare -A FUNCS=(
{{- range .Steps }}
  [{{ .Name }}]={{ .FuncName }}
{{- end }}
)

declare -A SELECTED=()
for arg in "$@"; do
  case "$arg" in
    -h|--help) usage; exit 0 ;;
    -l|--list)
      for step in "${STEPS[@]}"; do
        printf '  %-12s %s\n' "$step" "${DESCRIPTIONS[$step]}"
      done
      exit 0 ;;
    -*) echo "rig-update: unknown option: $arg" >&2; usage >&2; exit 2 ;;
    *)
      if [ -z "${FUNCS[$arg]+set}" ]; then
        echo "rig-update: unknown step: $arg (steps: ${STEPS[*]})" >&2
        exit 2
      fi
      SELECTED[$arg]=1 ;;
  esac
done

FAILED=()
for step in "${STEPS[@]}"; do
  if [ "${#SELECTED[@]}" -gt 0 ] && [ -z "${SELECTED[$step]+set}" ]; then
    continue
  fi
  echo "==> $step: ${DESCRIPTIONS[$step]}"
  # Each step runs in a subshell so one step's environment (e.g. sourcing
  # SDKMAN) cannot leak into the next, and a failure does not stop the rest.
  if ( "${FUNCS[$step]}" ); then
    echo "==> $step: done"
  else
    echo "==> $step: FAILED" >&2
    FAILED+=("$step")
  fi
done

echo
if [ "${#FAILED[@]}" -gt 0 ]; then
  echo "rig-update: ${#FAILED[@]} step(s) failed: ${FAILED[*]}" >&2
  echo "rig-update: re-run just those with: rig-update ${FAILED[*]}" >&2
  exit 1
fi
echo "rig-update: all steps succeeded."
echo "Services started with the container (markdown server, code-server) keep"
echo "running their old versions until it restarts: rig down, then rig up."
